   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "吉野山たかねの桜さき出てをよはぬ雲の色になりぬる",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花三首",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "一ふの夜の月とはいはし春ことの花にめてゝも老となるもの",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花三首",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "ちる花のうき世を人の歎すはたか身の夢としられさらまし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花三首",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "花もなく月も残らぬ比をしそをのか物なる春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春曙",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "なはしつのあせもしとろに行水のすみもさためすなく蛙哉",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "苗代",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "妻たつすゑ野のきゝす狩人の跡をいのちと音をやなくらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野雉",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "春雨に笠とり山は岩つゝしひかけの色にてりかへてけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "躑躅",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "あひおひの松に契をかけしより藤の土之勢や春にそふらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松上藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "春の色そわつかにみゆる古郷に人もすさめぬ庭の山ふき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里数冬",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "人なみにあくかれ立ても本の身のうきにかへきと春や行らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "枝かはす木ゝにもわきて春によしならのひろはやまつ茂らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十五首新樹",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "夜もすからまかへし月はかけさへて雪をまことのけさのうの花",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "我を侍なくひもあらは郭公こぬ夜のうさやおもひしらせん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時鳥二首",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "雲はやみた暮雨の足引の山ほとゝきすわたる一こゑ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時鳥二首",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "ねをかけぬたか袖ゆへに残きてぬ方のはやめの露こほるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "ふりて世にすむかひりなし五月雨の雲のそこなる在明の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月両",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "〽ほときすたたは過しと見えてけりあふち木くらき里の遠かしく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里櫓",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "夢さめてむかしも遠きねまくらにわす主かしみの軒のたち花",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭橋",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "それならぬ草木にすむもいかならんいつゝを雪のみしかよの内",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "夏草のふかきこゝろの色なからこゝ道にまにはかなさ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "はま恋の秋にもなりは思ひしれしか侍あかずしのゝめの空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "照射",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "うきしつみあはれにもゆる筋りな鴉舟の後の行衛しらすみ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜河",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "ゆふたちのなこりなからも朝日山日かけはみねに久しのほりつゝ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "木の間する日かけやうすき鳴蝉もしゝ覚にうつる夕くれの声",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "晩蝉",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "御祓する麻のみたれは取捨てそよやかへさの秋かせかせ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "荒和抜",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "袖のうへ枕の下も打しほれわきえぬ秋の露の露の雨の",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二十首初秋露",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "たゝ一夜袖ほすゆへそみなし川秋よりさきの名にはなかれし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "吹むすふ軒はの萩の露なからきえゆへ夢の跡の跡の勢",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩風",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "をく露もふかゝや秋の成ぬらん野辺のき萩の色かはるまて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野外萩",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "こと草はさきこほれても花すゝきなひく姿のにる物そなき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "すり衣それにはあらぬ女郎花なとる山あひに咲てみゆらぬ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "女郎花",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "おもひありと聞ふすかくに余のよのふくるはかなし松虫の声",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "虫",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "屋よしはし軒の一はの夕あらし袖のなみ堂のもろさくへん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋文",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "なをさりのさよのねさめの物そとや泪をもみぬさをしかの声",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深夜鹿",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "あしたつのたつぬる跡か浜川の入江の波にうつうなくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江鶏",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "月出るやまとしまねもうかふなりなみもいなみの海の夕なき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月三首",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "をも雄や入ぬる月の跡まてもなかめはあかぬ山のものそら",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月三首",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "身をてらすかけともあふき憂事をかたつもおほし嫁のよの月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月三首",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "打しもあれ色も色にてわたる也とよはた雲の衣かりかね",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮天雁",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "立の月る霧より上に時雨遣り胡露はらぬ嶺のまつかせ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝霧",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "一夜や寒きうつや衣を敷妙の袖にかさぬる妹のさと人",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "庭の草野はらの浅茅うら枯て木すゑにこつる秋の色かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉二首紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "龍田姫おもひの色の色の色のしのひもあへぬ木ゝのもみちは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉二首紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "置後よふまかきの霜もふかきよの丸明の月のしら菊の花",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬菊",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "しほれしはことの数にもなみら哉いまはの秋の袖のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "神無月立田の山の雲か勢も木東にまかふ色そこひしき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十五首初冬",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "しくれつゝくれてきのふの秋篠やと山の雲の唐のやすきよ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山時雨",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "一さらは又染もつらさてそのまゝにうすきもはては敷木葉哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "見るまゝに難波江遠く成にけり汀のあしの冬かれのころ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江寒薫",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "一松たてる磯のうら風さえぬらし由良のとなみに千鳥石はなく",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "くるゝよて池のさゝ波多つ鴨のをりぬる鷹は氷してけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "あたにしもうき身の袖を頼むや草木かけなき冬の夜の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "ふりにせり次からにさめしさよ衣うらめつらしきそ朝の初雪",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三首雪",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "尾上なる松よりあする程なれや岩里の軒のしらゆき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三首雪",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "いかはかり河せの波も氷類らん林の雪の夕くれのそら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三首雪",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "面かけもたえていく世に成ぬらん野守のかゝみうけしみゆれは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "神さひてうしふゆ立のもと末もよりあひの音のいつれともなく",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神楽",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "すみかまの煙にきはふ里見へて民のかまとのひ方そしらるゝ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竈",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "とにかくに身にもおほへぬ年暮てなやらふ夜にも成りにける哉",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "除夜",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "いかにせん世かたりならすなしはてゝつゝへん人のあはまほしさよ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "八十五首尋縁恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "いつしまに染ける色そ初もみち秋堂に露もしらぬしほるに",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "色に見え袖にもあたに藪すなよしのふの露は置あまるとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恩慮",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "思ひあまり名も立ぬへくくるしきにきゝをもり焼はうれしからまし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞応",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "早くはかり袖をかはさぬ中たにもなひくならひはあり是しら南",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "影欠",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "きえかへる命を神にまかせてもあみたの露のかゝるしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祈恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "なをさりに思ふ色とはこゝかはしうたてもなとかつれなかりらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "あたならす我こそ契れおくの海のいさしらなみの末の松山",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "此まゝにさしてぬる夜の真木の戸にあせていかれる心ちかはせん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "こよひこそぬれし袂もひたち帯のひもとげてゝめなりあひぬれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢慮",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "さたかなるうつゝにたにもわかさりきこれは恋しき夢の契よ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遇不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "玉つさのそのはしかきのつれなにを加みはしちのまろねせよとや",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "通書恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "さらにこそゆるしきやりぬ又みたにしらてはかなき袖の別路",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜別応",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "うき名のみをしあせかたのなくはしも又や思ふと夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "頭名恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "うつり竹松のひゝきの絶しより身を余か勢の末のまくすは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "世の中の夢もしはしと残けりあかつきことの鐘のひゝきに",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁鐘",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "ことの葉にふもとのちりの数とたにつもらはゆるせ玉津しま山",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所山",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "〽田子のうらやおきつの波はさもあらはあれふしの煙草たぬ日もなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所浦",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "名にしおもふそのかみよりや千とせ山みねなる松も生はしめけん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古松",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "くれ竹のはしに我身は成ぬともうへてや世々のかけを頼まん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "栽竹",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "一山里の下樋に水の道はあれとうへなる、苔を人はかよはす",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "幽経苔",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "そははやわか身ふりゆく霜の鶴雲ゐるをよふ色そかひなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "露",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "まかひつゝ比しもわかす飛鳥のさき板山にふれるしらゆき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "踏鳥",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "日くるれはこもかり船ものほるなりかへさやいそく淀のさと人",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河舟",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "野辺の露はたかならはしと結ふらん夢もとまらぬ草の枕に",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "宮こおもふ夢もなみちにまよふなりやとかる月も袖にくしけて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅泊",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "あわれなる花の盤も杉のいほにすむ人ありとみよし野の奥",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "名も遠きなにはの宮の跡とては高津の海の海の海の海の",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海眺望",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "身のほとに身をもくらふる身なりせはをろかな帰身を身とや頼まん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "あしはるは国常立のはしめにて幾代をまれる神となり釼",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄神祝",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "風の声人のころも遣ふよりそのとけかるへき春はきにをり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "応永廿六年十月日せ首立春"
  },
  {
   "seq": "102",
   "text": "春はまし霞の袖をこほ姫の高角山にふるかとそみな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山霞",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "我友だ鶯堂にもおもへはや竹の臺に馴て鳴らん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "竹鶯",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "心して摘こそわかめ春日野のをとろ交にみゆる若菜を",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733737",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野若菜",
   "kotobagaki": ""
  }
 ],
